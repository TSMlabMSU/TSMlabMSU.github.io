---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import lab from '../data/lab.yaml';
import type { ImageMetadata } from 'astro';

// Layer-2: themes come FROM the research collection (single source of truth), ordered
// by `order`. Each theme's figure + alt live in its OWN frontmatter (`figure`,
// `figureAlt`) — adding a theme is just a new .md plus an image in the folder below;
// no page edit and no hard-coded count. A frontmatter string can't be a static asset
// import on its own, so figures are resolved to Astro-optimized assets via
// import.meta.glob, keyed by file basename.
const figModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/research/*.{png,jpg,jpeg,webp,avif,svg}',
  { eager: true }
);
const figByBase: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(figModules)) {
  figByBase[path.split('/').pop()!] = mod.default;
}
const resolveFig = (p?: string): ImageMetadata | undefined =>
  p ? figByBase[p.split('/').pop()!] : undefined;

const themes = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  themes.map(async (t) => {
    const { Content } = await render(t);
    return { data: t.data, slug: t.data.slug, Content, img: resolveFig(t.data.figure), alt: t.data.figureAlt ?? '' };
  })
);
---
<BaseLayout active="research" title="Research — TSM Lab @ MSU">
    <main id="main">
      <section class="pad" style="max-width:820px;margin:0 auto;padding:72px 64px 24px;">
        <div style="display:flex;align-items:center;gap:14px;font-family:var(--mono);font-size:12px;letter-spacing:3px;text-transform:uppercase;color:var(--muted);margin-bottom:18px;"><span aria-hidden="true" style="width:26px;height:1px;background:var(--accent);flex:none;"></span><span>Research</span></div>
        <h1 class="h1" style="font-family:var(--serif);font-weight:600;font-size:clamp(2.2rem,1.6rem+2.2vw,3rem);line-height:1.05;letter-spacing:-.6px;margin:0;">{lab.pages.research.heading}</h1>
        {lab.pages.research.intro.map((para: string, i: number) => (
          <p style={`font-size:clamp(1rem,.95rem+.4vw,1.15rem);line-height:1.6;color:var(--ink2);max-width:62ch;margin:${i === 0 ? '20px' : '14px'} 0 0;`}>{para}</p>
        ))}

      </section>

      <section class="pad" style="max-width:1100px;margin:0 auto;padding:36px 64px 72px;">

        {rendered.map((theme, i) => {
          // Alternating layout: even rows have the figure on the right, odd rows on the left.
          const figLeft = i % 2 === 1;
          const last = i === rendered.length - 1;
          const figure = theme.img && (
            <figure class="theme-fig" style="margin:0;"><Image src={theme.img} alt={theme.alt} widths={[520, 1040]} sizes="(max-width: 860px) 100vw, 490px" loading="lazy" style="display:block;width:100%;height:auto;background:#fff;" /></figure>
          );
          const body = (
            <div>
              {/* Mono index numeral — same theme numbering language as the home teasers. */}
              <div style="font-family:var(--mono);font-size:11px;letter-spacing:2px;color:var(--muted2);margin-bottom:12px;">{String(i + 1).padStart(2, '0')}</div>
              <h2 style="font-family:var(--serif);font-weight:600;font-size:clamp(1.4rem,1.2rem+1vw,1.8rem);letter-spacing:-.3px;margin:0 0 14px;">{theme.data.title}</h2>
              <div class="theme-body" style="font-size:15px;line-height:1.7;color:var(--ink2);"><theme.Content /></div>
            </div>
          );
          return (
            <article class="theme-row reveal" style={`display:grid;grid-template-columns:${theme.img ? '1fr 1fr' : '1fr'};gap:48px;align-items:center;padding:44px 0;border-top:1px solid var(--line);${last ? 'border-bottom:1px solid var(--line);' : ''}`}>
              {!theme.img ? body : figLeft ? <>{figure}{body}</> : <>{body}{figure}</>}
            </article>
          );
        })}

      </section>

    </main>

  <style>
    .theme-body :global(p){margin:0;}
    .theme-body :global(p + p){margin-top:14px;}
    .theme-body :global(ul){margin:14px 0 0;padding-left:18px;font-size:14px;line-height:1.7;color:var(--muted);}
    @media (max-width:860px){
      .theme-row{grid-template-columns:1fr !important;gap:18px !important;}
      .theme-row .theme-fig{order:-1 !important;}
    }
    @media (max-width:760px){
      .theme-fig img{height:auto !important;}
    }
  </style>
</BaseLayout>
