---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { newsSlug } from '../lib/news';

// Layer-2: render the news list FROM the content collection (single source of truth).
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group by year, descending. Dates are authored as bare YYYY-MM-DD (parsed as UTC
// midnight), so read them back in UTC — never local — to avoid an off-by-one day.
const byYear = new Map<number, typeof news>();
for (const item of news) {
  const y = item.data.date.getUTCFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(item);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

// 'YYYY · MM · DD' from the item date (UTC).
const fmtDate = (d: Date) => {
  const p = (n: number) => String(n).padStart(2, '0');
  return `${d.getUTCFullYear()} · ${p(d.getUTCMonth() + 1)} · ${p(d.getUTCDate())}`;
};
// machine-readable datetime attr (UTC).
const isoDate = (d: Date) => {
  const p = (n: number) => String(n).padStart(2, '0');
  return `${d.getUTCFullYear()}-${p(d.getUTCMonth() + 1)}-${p(d.getUTCDate())}`;
};
// Descriptive link text by category (a bare "Link" says nothing to screen readers or scanners).
const linkLabel = (cat?: string) =>
  cat === 'talk' || cat === 'video' ? 'Video ↗' : cat === 'paper' ? 'Paper ↗' : 'Link ↗';

// Per-row padding to mirror the original first/middle/last/single layout.
function rowStyle(idx: number, count: number) {
  if (count === 1) return 'display:flex;gap:22px;padding:0;';
  if (idx === 0) return 'display:flex;gap:22px;padding:0 0 16px;';
  if (idx === count - 1) return 'display:flex;gap:22px;padding:16px 0 0;border-top:1px solid var(--line);';
  return 'display:flex;gap:22px;padding:16px 0;border-top:1px solid var(--line);';
}
---
<BaseLayout active="news" title="News — TSM Lab @ MSU">
    <main id="main">
      <section class="pad" style="max-width:880px;margin:0 auto;padding:72px 64px 20px;">
        <div style="display:flex;align-items:center;gap:14px;font-family:var(--mono);font-size:12px;letter-spacing:3px;text-transform:uppercase;color:var(--muted);margin-bottom:18px;"><span aria-hidden="true" style="width:26px;height:1px;background:var(--accent);flex:none;"></span><span>News</span></div>
        <h1 class="h1" style="font-family:var(--serif);font-weight:600;font-size:clamp(2.2rem,1.6rem+2.2vw,3rem);line-height:1.05;letter-spacing:-.6px;margin:0;">Latest from the lab</h1>
        <p style="font-size:clamp(1rem,.95rem+.4vw,1.15rem);line-height:1.6;color:var(--ink2);max-width:60ch;margin:20px 0 0;">Papers, defenses, awards, and grants, newest first. <a href="/feed.xml" style="color:var(--ink2);text-decoration:underline;text-underline-offset:3px;">Atom feed</a> available.</p>
      </section>

      <section class="pad" style="max-width:880px;margin:0 auto;padding:28px 64px 80px;">
{years.map((year, yi) => {
  const items = byYear.get(year)!;
  const lastYear = yi === years.length - 1;
  const groupStyle = `display:grid;grid-template-columns:150px 1fr;gap:36px;padding:24px 0;border-top:1px solid var(--line2);${lastYear ? 'border-bottom:1px solid var(--line2);' : ''}`;
  return (
        <div class="newsyear" style={groupStyle}>
          <div class="newsyear-label" style="position:sticky;top:var(--hdr-offset);align-self:start;font-family:var(--serif);font-weight:500;font-size:40px;letter-spacing:-1px;color:var(--line2);height:fit-content;">{year}</div>
          <ul style="list-style:none;margin:0;padding:0;">
{items.map((item, idx) => (
            <li id={`news-${newsSlug(item)}`} class="nrow" style={rowStyle(idx, items.length)}>
              <time datetime={isoDate(item.data.date)} style="flex:none;width:118px;font-family:var(--mono);font-size:13px;color:var(--muted2);">{fmtDate(item.data.date)}</time>
              <div style="font-size:15px;line-height:1.55;color:var(--ink2);">
                <div>{item.data.title}{item.data.link && (<> <a href={item.data.link} style="color:var(--accent);text-decoration:underline;text-underline-offset:3px;">{linkLabel(item.data.category)}</a></>)}</div>
              </div>
            </li>
))}
          </ul>
        </div>
  );
})}
      </section>
    </main>
</BaseLayout>

<style>
  /* Page-specific responsive rules from the design's <helmet> (not in global.css). */
  @media (max-width:760px){
    .newsyear{grid-template-columns:1fr !important;gap:6px !important;}
    .newsyear-label{position:static !important;font-size:30px !important;}
    .nrow{flex-direction:column !important;gap:3px !important;}
    .nrow time{width:auto !important;}
  }
</style>
