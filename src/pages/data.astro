---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { datasetNode } from '../lib/jsonld';
import pubsData from '../data/publications.csl.json';

// Resolve a dataset's related publication (by citekey) to the paper's DIRECT location —
// its DOI (canonical) or hosted PDF — rather than the publications-list page.
const pubByKey = new Map((pubsData as Array<{ id: string; DOI?: string; pdfUrl?: string }>).map((p) => [p.id, p]));
function relatedPaperHref(d: CollectionEntry<'datasets'>): string {
  const key = d.data.relatedPublications?.[0];
  const p = key ? pubByKey.get(key) : undefined;
  if (p?.DOI) return `https://doi.org/${p.DOI}`;
  if (p?.pdfUrl) return p.pdfUrl;
  return '/publications';
}

// Dataset cards + Dataset JSON-LD both derive from the
// datasets collection (single source of truth), ordered oldest-first as on the live site.
const datasets = (await getCollection('datasets')).sort(
  (a, b) => (a.data.date?.valueOf() ?? 0) - (b.data.date?.valueOf() ?? 0)
);
const jsonld = datasets.map((d) => datasetNode(d.data));

// Card chips show the topical keywords; the lab-wide umbrella keyword "turbulence"
// is kept in the data (for JSON-LD/SEO) but not rendered as a card chip.
const chipKeywords = (kw?: string[]) => (kw ?? []).filter((k) => k !== 'turbulence');
const creatorName = (c: { literal?: string; given?: string; family?: string }) =>
  c.literal ?? [c.given, c.family].filter(Boolean).join(' ');
// A related publication is "confirmed" only when its citekey is real (not a TODO placeholder).
const hasRealPaper = (d: CollectionEntry<'datasets'>) =>
  !!d.data.relatedPaperLabel && !/^TODO\(/.test(d.data.relatedPublications[0]);
---
<BaseLayout active="data" title="Data & Code — TSM Lab @ MSU" jsonld={jsonld}>
    <main id="main">
      <section class="pad" style="max-width:820px;margin:0 auto;padding:72px 64px 16px;">
        <div style="display:flex;align-items:center;gap:14px;font-family:var(--mono);font-size:12px;letter-spacing:3px;text-transform:uppercase;color:var(--muted);margin-bottom:18px;"><span aria-hidden="true" style="width:26px;height:1px;background:var(--accent);flex:none;"></span><span>Data &amp; Code</span></div>
        <h1 class="h1" style="font-family:var(--serif);font-weight:600;font-size:clamp(2.2rem,1.6rem+2.2vw,3rem);line-height:1.05;letter-spacing:-.6px;margin:0;">Open simulation data</h1>
        <p style="font-size:clamp(1rem,.95rem+.4vw,1.15rem);line-height:1.6;color:var(--ink2);max-width:62ch;margin:20px 0 0;">Open datasets from our simulations, each with a citable DOI and linked to the paper it supports.</p>
      </section>

      <section class="pad" style="max-width:820px;margin:0 auto;padding:32px 64px 8px;">
        <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:22px;">
          {datasets.map((d) => (
          <li class="reveal" style="border:1px solid var(--line);border-radius:4px;padding:28px 30px;background:var(--bg);">
            <div class="ds-head" style="display:flex;justify-content:space-between;align-items:baseline;gap:18px;margin-bottom:12px;">
              <div style="font-family:var(--mono);font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted2);">{d.data.cardLabel}</div>
              <div style="font-family:var(--mono);font-size:12px;color:var(--muted2);">{d.data.date?.getUTCFullYear()}</div>
            </div>
            <h2 style="font-family:var(--serif);font-weight:600;font-size:20px;line-height:1.3;margin:0 0 10px;">{d.data.title}</h2>
            <p style="font-size:14px;line-height:1.6;color:var(--muted);margin:0 0 14px;max-width:64ch;">{d.data.shortDescription}</p>
            <div style="font-family:var(--mono);font-size:12px;color:var(--muted2);margin-bottom:16px;">{d.data.creators.map(creatorName).join(' · ')}</div>
            <div style="display:flex;flex-wrap:wrap;gap:10px 12px;align-items:center;margin-bottom:16px;">
              {chipKeywords(d.data.keywords).map((k) => (
              <span style="font-family:var(--mono);font-size:11px;color:var(--ink2);border:1px solid var(--line2);border-radius:2px;padding:3px 9px;">{k}</span>
              ))}
            </div>
            <div style="border-top:1px solid var(--line);padding-top:14px;display:flex;flex-wrap:wrap;gap:8px 26px;align-items:baseline;font-size:13px;">
              <a href={`https://doi.org/${d.data.doi}`} style="font-family:var(--mono);font-size:12.5px;color:var(--accent);text-decoration:underline;text-underline-offset:3px;">DOI {d.data.doi} ↗</a>
              {hasRealPaper(d)
                ? (<span style="color:var(--muted2);">Related paper: <a href={relatedPaperHref(d)} style="color:var(--ink2);text-decoration:underline;text-underline-offset:3px;">{d.data.relatedPaperLabel} ↗</a></span>)
                : (<span style="color:var(--muted2);">License: <span style="font-style:italic;">{d.data.license}</span></span>)}
            </div>
          </li>
          ))}
        </ul>
      </section>

      <section class="pad reveal" style="max-width:820px;margin:0 auto;padding:36px 64px 80px;">
        <div style="background:var(--bg2);border:1px solid var(--line);border-radius:4px;padding:22px 24px;display:flex;flex-wrap:wrap;gap:14px 32px;align-items:center;justify-content:space-between;">
          <div style="font-size:13px;color:var(--muted);max-width:46ch;">All datasets are <a href="https://creativecommons.org/licenses/by/4.0/" style="color:var(--ink2);text-decoration:underline;text-underline-offset:3px;">CC-BY 4.0</a> unless noted. Machine-readable index:</div>
          <div style="display:flex;flex-wrap:wrap;gap:10px 18px;">
            <a href="/datasets.json" style="font-family:var(--mono);font-size:12px;color:var(--accent);text-decoration:underline;text-underline-offset:3px;">datasets.json</a>
            <a href="/publications.bib" style="font-family:var(--mono);font-size:12px;color:var(--accent);text-decoration:underline;text-underline-offset:3px;">publications.bib</a>
          </div>
        </div>
      </section>
    </main>
</BaseLayout>

<style>
  @media (max-width: 760px) {
    .ds-head { flex-direction: column !important; gap: 8px !important; }
  }
</style>
