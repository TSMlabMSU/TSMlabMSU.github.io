---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import { piPerson } from '../lib/jsonld';
import lab from '../data/lab.yaml';
import EmailLink from '../components/EmailLink.astro';
import type { ImageMetadata } from 'astro';
// Re-hosted, Astro-optimized figures (src/assets/images/, never hot-linked).
import portraitYuan from '../assets/images/people/junlin-yuan-2.jpg';

// Group photo resolves from lab.yaml (pages.team.groupPhoto.file) to an optimized asset,
// keyed by file basename — same pattern as the research figures.
const groupModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/group/*.{png,jpg,jpeg,webp,avif}',
  { eager: true }
);
const groupImg = Object.entries(groupModules).find(
  ([p]) => p.split('/').pop() === lab.pages.team.groupPhoto.file
)?.[1].default;
const piLink = (rel: string): string | undefined =>
  lab.pi.links.find((l: { rel: string; url: string }) => l.rel === rel)?.url;

const jsonld = [piPerson()];
const pi = lab.pi;

// Layer-2: rosters FROM the people collection (single source of truth), split by status.
// The collaborator (Giles Brereton) stays in the group-photo caption only, never in a roster.
const people = await getCollection('people');

// Current members (excluding PI + collaborators), ordered by the optional `order` frontmatter
// field (lower first), then by name. Adding a current member via the tsm-site skill needs no
// edit here: set `order` in the person file to place them, or omit it to sort by name at the end.
const currentMembers = people
  .filter((p) => p.data.status === 'current' && p.data.role !== 'pi' && p.data.role !== 'collaborator')
  .sort(
    (a, b) =>
      (a.data.order ?? Infinity) - (b.data.order ?? Infinity) || a.data.name.localeCompare(b.data.name)
  );
const bodyText = (p: CollectionEntry<'people'>) => p.body?.trim() ?? '';

// Tenure label reproducing the live-site formatting:
//   bare years            -> "2023 – 2024"
//   same year, YYYY-MM    -> "May – Aug 2020"
//   different years       -> "Aug 2023 – Dec 2024"
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const tenureLabel = (t?: { start: string; end: string | null }) => {
  if (!t) return '';
  const parse = (s: string) => {
    const [y, m] = s.split('-');
    return { y, m: m ? MONTHS[parseInt(m, 10) - 1] : null };
  };
  const a = parse(t.start);
  const b = t.end ? parse(t.end) : null;
  if (!a.m) {
    // bare-year tenure
    return b ? `${a.y} – ${b.y}` : a.y;
  }
  if (!b) return `${a.m} ${a.y}`;
  if (a.y === b.y) return `${a.m} – ${b.m} ${a.y}`;
  return `${a.m} ${a.y} – ${b.m} ${b.y}`;
};

const alumni = people.filter((p) => p.data.status === 'alumni');
// Past doctoral / undergraduate, each descending by tenure start.
const byStartDesc = (a: CollectionEntry<'people'>, b: CollectionEntry<'people'>) =>
  (a.data.tenure?.start ?? '') < (b.data.tenure?.start ?? '') ? 1 : -1;
const pastDoctoral = alumni.filter((p) => p.data.role === 'phd').sort(byStartDesc);
const pastMasters = alumni.filter((p) => p.data.role === 'ms').sort(byStartDesc);
const pastUndergrad = alumni.filter((p) => p.data.role === 'undergrad').sort(byStartDesc);
// Catch-all so an alumni postdoc/staff/visitor is never silently dropped from the page.
const pastOther = alumni
  .filter((p) => !['phd', 'ms', 'undergrad'].includes(p.data.role))
  .sort(byStartDesc);
---
<BaseLayout active="team" title="Team — TSM Lab @ MSU" jsonld={jsonld}>
    <main id="main">
      <section class="pad" style="max-width:820px;margin:0 auto;padding:72px 64px 24px;">
        <div style="display:flex;align-items:center;gap:14px;font-family:var(--mono);font-size:12px;letter-spacing:3px;text-transform:uppercase;color:var(--muted);margin-bottom:18px;"><span aria-hidden="true" style="width:26px;height:1px;background:var(--accent);flex:none;"></span><span>People</span></div>
        <h1 class="h1" style="font-family:var(--serif);font-weight:600;font-size:clamp(2.2rem,1.6rem+2.2vw,3rem);line-height:1.05;letter-spacing:-.6px;margin:0;">Team</h1>
        <p style="font-size:clamp(1rem,.95rem+.4vw,1.15rem);line-height:1.6;color:var(--ink2);max-width:60ch;margin:20px 0 0;">{lab.pages.team.lede}</p>
      </section>

      <section class="pad reveal" style="max-width:920px;margin:0 auto;padding:44px 64px;">
        <div class="pi-row" style="display:flex;gap:48px;align-items:flex-start;">
          <div class="pi-photo" style="flex:none;width:260px;border:1px solid var(--line2);">
            <Image src={portraitYuan} alt="Prof. Junlin Yuan, Principal Investigator of the TSM Lab." widths={[260, 520]} sizes="(max-width: 760px) 190px, 260px" style="display:block;width:100%;height:auto;" />
          </div>
          <div>
            <div style="font-family:var(--mono);font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--muted2);margin-bottom:10px;">Principal Investigator</div>
            <h2 style="font-family:var(--serif);font-weight:600;font-size:clamp(1.6rem,1.4rem+1vw,2rem);margin:0 0 6px;letter-spacing:-.3px;">{pi.name}</h2>
            <div style="font-size:14px;color:var(--muted);margin-bottom:18px;">{pi.title}</div>
            <p style="font-size:15px;line-height:1.7;color:var(--ink2);margin:0 0 14px;max-width:58ch;">{pi.bioTeam}</p>
            <div style="display:grid;grid-template-columns:auto 1fr;gap:6px 18px;font-size:14px;color:var(--ink2);margin:0 0 22px;max-width:58ch;">
              <span style="font-family:var(--mono);font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--muted2);padding-top:2px;">Topics</span><span>{pi.topics.join(' · ')}</span>
              <span style="font-family:var(--mono);font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--muted2);padding-top:2px;">Areas</span><span>{pi.areas}</span>
              <span style="font-family:var(--mono);font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--muted2);padding-top:2px;">Funding</span><span>{lab.funders.join(' · ')}</span>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:12px 22px;align-items:center;">
              <a href={pi.cvUrl} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;font-family:var(--mono);font-size:12px;letter-spacing:.5px;text-transform:uppercase;color:var(--bg);background:var(--ink);text-decoration:none;border:1px solid var(--ink);border-radius:3px;padding:9px 16px;">CV (PDF) ↗</a>
              <a href={piLink('scholar')} target="_blank" rel="noopener" style="font-size:14px;color:var(--ink2);text-decoration:underline;text-underline-offset:3px;">Google Scholar</a>
              <a href={piLink('researchgate')} target="_blank" rel="noopener" style="font-size:14px;color:var(--ink2);text-decoration:underline;text-underline-offset:3px;">ResearchGate</a>
              <a href={piLink('faculty')} target="_blank" rel="noopener" style="font-size:14px;color:var(--ink2);text-decoration:underline;text-underline-offset:3px;">MSU Faculty</a>
              <a href={piLink('orcid')} style="font-size:14px;color:var(--ink2);text-decoration:underline;text-underline-offset:3px;">orcid.org/0000-0002-4711-6452</a>
              <EmailLink label="Email" style="font-size:14px;color:var(--ink2);text-decoration:underline;text-underline-offset:3px;" />
            </div>
          </div>
        </div>
      </section>

      <section class="pad reveal" style="max-width:1100px;margin:0 auto;padding:32px 64px 8px;">
        <figure style="margin:0;">
          {groupImg && (
            <Image src={groupImg} alt={lab.pages.team.groupPhoto.alt} widths={[760, 1100, 2200]} sizes="(max-width: 1100px) 100vw, 972px" loading="lazy" style="display:block;width:100%;height:auto;border:1px solid var(--line);" />
          )}
        </figure>
        <p style="font-size:13px;line-height:1.6;color:var(--muted);margin:14px 0 0;max-width:80ch;">{lab.pages.team.groupPhoto.caption}</p>
      </section>

      <section class="pad" style="max-width:1100px;margin:0 auto;padding:56px 64px 16px;">
        <h2 class="reveal" style="font-family:var(--serif);font-weight:600;font-size:clamp(1.5rem,1.3rem+1vw,1.9rem);letter-spacing:-.3px;margin:0 0 28px;">Current members</h2>
        <ul class="reveal" style="list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;justify-content:center;align-items:stretch;gap:24px;">
          {/* Eyebrow (role) → serif name → short accent rule → bio: the site's own kicker
              language instead of an initials avatar (the brand is near-iconless by design). */}
          {currentMembers.map((m) => (
          <li style="flex:0 1 340px;max-width:360px;background:var(--bg);border:1px solid var(--line);padding:26px 24px;">
            <div style="font-family:var(--mono);font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--muted2);margin-bottom:10px;">{m.data.roleLabel}</div>
            <h3 style="font-family:var(--serif);font-weight:600;font-size:21px;letter-spacing:-.2px;margin:0 0 14px;">{m.data.name}</h3>
            <div aria-hidden="true" style="width:26px;height:1px;background:var(--accent);margin-bottom:14px;"></div>
            <p style={`font-size:14px;line-height:1.6;${bodyText(m) === 'Profile coming soon.' ? 'color:var(--muted2);margin:0;font-style:italic;' : 'color:var(--muted);margin:0;'}`}>{bodyText(m)}</p>
          </li>
          ))}
        </ul>
      </section>

      <section class="pad" style="max-width:820px;margin:0 auto;padding:56px 64px 80px;">
        <h2 class="reveal" style="font-family:var(--serif);font-weight:600;font-size:clamp(1.5rem,1.3rem+1vw,1.9rem);letter-spacing:-.3px;margin:0 0 8px;">Past members</h2>

        <h3 class="reveal" style="font-family:var(--mono);font-weight:500;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin:28px 0 6px;">Doctoral</h3>
        <ul class="reveal" style="list-style:none;margin:0;padding:0;">
          {pastDoctoral.map((p, i) => {
            const last = i === pastDoctoral.length - 1;
            return (
          <li class="alum-row" style={`display:flex;gap:24px;padding:18px 0;border-top:1px solid var(--line);${last ? 'border-bottom:1px solid var(--line);' : ''}`}>
            <div class="alum-tenure" style="flex:none;width:170px;font-family:var(--mono);font-size:12px;color:var(--muted2);line-height:1.5;">{tenureLabel(p.data.tenure)}</div>
            <div><div style="font-size:16px;font-weight:600;color:var(--ink);margin-bottom:3px;">{p.data.name}</div><div style="font-size:14px;color:var(--muted);line-height:1.55;">{bodyText(p)}{p.data.placement && (<>{' '}<Fragment set:html="&nbsp;" /><span style="color:var(--ink2);">{p.data.placement}</span></>)}</div></div>
          </li>
            );
          })}
        </ul>

        {pastMasters.length > 0 && (
        <Fragment>
        <h3 class="reveal" style="font-family:var(--mono);font-weight:500;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin:36px 0 6px;">Master's</h3>
        <ul class="reveal" style="list-style:none;margin:0;padding:0;">
          {pastMasters.map((p, i) => {
            const last = i === pastMasters.length - 1;
            return (
          <li class="alum-row" style={`display:flex;gap:24px;padding:18px 0;border-top:1px solid var(--line);${last ? 'border-bottom:1px solid var(--line);' : ''}`}>
            <div class="alum-tenure" style="flex:none;width:170px;font-family:var(--mono);font-size:12px;color:var(--muted2);line-height:1.5;">{tenureLabel(p.data.tenure)}</div>
            <div><div style="font-size:16px;font-weight:600;color:var(--ink);margin-bottom:3px;">{p.data.name}</div><div style="font-size:14px;color:var(--muted);line-height:1.55;">{bodyText(p)}{p.data.placement && (<>{' '}<Fragment set:html="&nbsp;" /><span style="color:var(--ink2);">{p.data.placement}</span></>)}</div></div>
          </li>
            );
          })}
        </ul>
        </Fragment>
        )}

        <h3 class="reveal" style="font-family:var(--mono);font-weight:500;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin:36px 0 6px;">Undergraduate</h3>
        <ul class="reveal" style="list-style:none;margin:0;padding:0;">
          {pastUndergrad.map((p, i) => {
            const last = i === pastUndergrad.length - 1;
            return (
          <li class="alum-row" style={`display:flex;gap:24px;padding:16px 0;border-top:1px solid var(--line);${last ? 'border-bottom:1px solid var(--line);' : ''}`}>
            <div class="alum-tenure" style="flex:none;width:170px;font-family:var(--mono);font-size:12px;color:var(--muted2);">{tenureLabel(p.data.tenure)}</div>
            <div><div style="font-size:15px;font-weight:600;color:var(--ink);margin-bottom:2px;">{p.data.name}</div><div style="font-size:14px;color:var(--muted);">{bodyText(p)}</div></div>
          </li>
            );
          })}
        </ul>

        {pastOther.length > 0 && (
        <Fragment>
        <h3 class="reveal" style="font-family:var(--mono);font-weight:500;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin:36px 0 6px;">Postdoctoral &amp; others</h3>
        <ul class="reveal" style="list-style:none;margin:0;padding:0;">
          {pastOther.map((p, i) => {
            const last = i === pastOther.length - 1;
            return (
          <li class="alum-row" style={`display:flex;gap:24px;padding:16px 0;border-top:1px solid var(--line);${last ? 'border-bottom:1px solid var(--line);' : ''}`}>
            <div class="alum-tenure" style="flex:none;width:170px;font-family:var(--mono);font-size:12px;color:var(--muted2);">{tenureLabel(p.data.tenure)}</div>
            <div><div style="font-size:15px;font-weight:600;color:var(--ink);margin-bottom:2px;">{p.data.name}</div><div style="font-size:14px;color:var(--muted);">{bodyText(p)}{p.data.placement && (<>{' '}<Fragment set:html="&nbsp;" /><span style="color:var(--ink2);">{p.data.placement}</span></>)}</div></div>
          </li>
            );
          })}
        </ul>
        </Fragment>
        )}
      </section>
    </main>

  <style>
    /* Page-specific responsive rules from the Team design's <style> not already in global.css.
       Shared classes (.pad, .site-hdr, .nav-*, .pi-row, .pi-photo, .h1) live in global.css and are not redefined here. */
    @media (max-width: 760px) {
      .alum-row { flex-direction: column !important; gap: 4px !important; }
      .alum-row .alum-tenure { width: auto !important; }
    }
  </style>
</BaseLayout>
