---
// Shared site header — single source for the nav + dark-mode toggle on every page.
// `active` selects which nav item is highlighted (aria-current + accent underline).
import LogoMark from './LogoMark.astro';
import site from '../data/site.yaml';
interface Props { active?: string }
const { active = '' } = Astro.props;

// Nav is single-sourced from site.yaml (`nav`). `menuLabel` overrides `label` in the mobile menu.
const items: { key: string; label: string; href: string; menuLabel?: string }[] = site.nav;

const deskActive = 'font-weight:600;color:var(--accent);text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:1px;';
const deskInactive = 'text-decoration:none;color:var(--ink2);';
const menuActive = 'color:var(--accent);font-weight:600;';
---
<header class="site-hdr pad inkband" style="position:sticky;top:0;z-index:30;display:flex;align-items:center;justify-content:space-between;padding:20px 64px;background:var(--bg);border-bottom:1px solid var(--line);">
  <a href="/" style="display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--ink);">
    <span style="width:32px;height:32px;border:1.5px solid var(--ink);border-radius:6px;display:flex;align-items:center;justify-content:center;flex:none;"><LogoMark size={22} /></span>
    <span style="font-family:var(--serif);font-weight:600;font-size:18px;letter-spacing:.2px;">TSM Lab <span style="color:var(--muted);font-weight:400;">@ MSU</span></span>
  </a>
  <nav class="nav-desktop" aria-label="Primary" style="display:flex;align-items:center;gap:28px;font-size:14px;color:var(--ink2);">
    {items.map((it) => (
      <a href={it.href} aria-current={active === it.key ? 'page' : undefined} style={active === it.key ? deskActive : deskInactive}>{it.label}</a>
    ))}
    <button type="button" data-theme-toggle aria-label="Toggle dark mode" style="display:flex;align-items:center;justify-content:center;width:32px;height:32px;border:1px solid var(--line2);border-radius:999px;background:var(--bg);color:var(--ink);cursor:pointer;font-size:14px;line-height:1;">◑</button>
  </nav>

  <details class="nav-mobile">
    <summary aria-label="Menu" style="display:flex;align-items:center;justify-content:center;width:40px;height:40px;border:1px solid var(--line2);border-radius:7px;">
      <svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true"><rect width="18" height="1.6" y="0" fill="currentColor"></rect><rect width="18" height="1.6" y="6.2" fill="currentColor"></rect><rect width="18" height="1.6" y="12.4" fill="currentColor"></rect></svg>
      <span class="sr-only">Menu</span>
    </summary>
    <div style="position:absolute;left:0;right:0;top:100%;background:var(--bg);border-bottom:1px solid var(--line);padding:4px 20px 18px;box-shadow:0 8px 16px rgba(0,0,0,.06);">
      {items.map((it) => (
        <a class="menu-link" href={it.href} aria-current={active === it.key ? 'page' : undefined} style={active === it.key ? menuActive : undefined}>{it.menuLabel ?? it.label}</a>
      ))}
      <button type="button" data-theme-toggle style="margin-top:14px;display:flex;align-items:center;gap:10px;font-family:var(--mono);font-size:12px;letter-spacing:1px;text-transform:uppercase;color:var(--ink);background:var(--bg);border:1px solid var(--line2);border-radius:999px;padding:9px 15px;cursor:pointer;">◑ Theme</button>
    </div>
  </details>
</header>

<script is:inline>
  // Progressive enhancement: a native <details> menu only closes by re-tapping its
  // summary. Users expect a dropdown to dismiss on an outside tap or Escape — add that.
  (function () {
    var menu = document.querySelector('details.nav-mobile');
    if (!menu) return;
    document.addEventListener('click', function (e) {
      if (menu.open && !menu.contains(e.target)) menu.removeAttribute('open');
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && menu.open) {
        menu.removeAttribute('open');
        var summary = menu.querySelector('summary');
        if (summary) summary.focus();
      }
    });
  })();
</script>
